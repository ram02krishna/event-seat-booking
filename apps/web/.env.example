# Public API and Socket URLs
# In local development:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# In production (e.g., Vercel):
# Set NEXT_PUBLIC_API_URL to your deployed API server (e.g., https://your-api.onrender.com)
# Set NEXT_PUBLIC_SOCKET_URL to your deployed API server WebSocket endpoint (e.g., https://your-api.onrender.com)
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com

# Optional: If you want Next.js to proxy /api/* requests instead of direct client-to-API calls:
# API_PROXY_URL=https://your-api.onrender.com
