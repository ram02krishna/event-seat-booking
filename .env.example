# Backend Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (e.g. localhost, Vercel domain, custom domain)
# Example: CLIENT_URL=http://localhost:3000,https://event-seat-booking.vercel.app
CLIENT_URL=http://localhost:3000

# Database & Redis (Required for backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_seat_booking?schema=public
REDIS_URL=redis://localhost:6379

# Auth (Generate a secure random 32+ character string for production)
JWT_SECRET=supersecretdevkey1234567890_min32chars

# Default Organizer Initial Account (Created on server start if not present)
ORGANIZER_EMAIL=organizer@eventseat.com
ORGANIZER_PASSWORD=password123

# Email (Resend) - Optional in development
RESEND_API_KEY=re_your_api_key_here

# Frontend (Vercel Environment Variables)
# In development:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# In production on Vercel:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com
