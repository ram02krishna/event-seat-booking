# Backend Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (e.g. localhost, Vercel domain, custom domain)
# Example: CLIENT_URL=http://localhost:3000,https://seat-lock.vercel.app
CLIENT_URL=http://localhost:3000

# Database & Redis (Required for backend)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seat_lock?schema=public
REDIS_URL=redis://localhost:6379

# Local development only; replace with a unique random 32+ character secret in production.
JWT_SECRET=supersecretdevkey1234567890_min32chars

# Local development only: organizer created on server start if not present.
# Production requires a dedicated email and a unique password of at least 8 characters.
ORGANIZER_EMAIL=organizer@eventseat.com
ORGANIZER_PASSWORD=password123

# Email (Resend) - Optional in development; required in production for signup/password reset.
RESEND_API_KEY=re_your_api_key_here
# Sender address verified with Resend:
RESEND_FROM_EMAIL=SeatLock <tickets@domain.me>
# Optional: In Resend free sandbox, emails can ONLY be sent to your registered Resend account email.
# Set RESEND_OVERRIDE_EMAIL to that registered email to forward all test emails there.
# RESEND_OVERRIDE_EMAIL=your_resend_email@example.com

# Frontend (Vercel Environment Variables)
# In development:
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# In production on Vercel:
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://your-api.onrender.com
